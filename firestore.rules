rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isSignedIn();
    }

    // Master Data Kapal
    match /vessels/{vesselId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data Dermaga
    match /berths/{berthId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Master Data Lapangan Penumpukan
    match /yardBlocks/{yardBlockId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Data Petikemas / Kontainer
    match /containers/{containerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Transaksi Gerbang (Gate In / Gate Out)
    match /gateTransactions/{gateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Histori Audit Trail
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Notifikasi Otomatis
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
